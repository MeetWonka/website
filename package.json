{
  "name": "wonka",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "bun": ">=1.1.0"
  },
  "scripts": {
    "predev": "bun run ds:build",
    "dev": "next dev --turbopack",
    "prebuild": "bun run ds:build",
    "build": "next build && node scripts/externalize-next-flight.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "ds:build": "node scripts/design-system/build.mjs",
    "ds:check": "node scripts/design-system/validate.mjs",
    "preds:query": "node scripts/design-system/validate.mjs --quiet",
    "ds:query": "node scripts/design-system/query.mjs",
    "storybook": "bun run ds:build && storybook dev -p 6006",
    "storybook:build": "bun run ds:build && storybook build",
    "test:storybook": "vitest run --project=storybook-light --project=storybook-dark",
    "test:storybook:watch": "vitest --project=storybook-light --project=storybook-dark"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@portabletext/react": "^6.0.3",
    "@sanity/document-internationalization": "^6.2.1",
    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@wonka/react": "workspace:*",
    "@wonka/tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "motion": "^12.38.0",
    "next": "16.2.4",
    "next-intl": "^4.13.0",
    "next-sanity": "^12.3.1",
    "posthog-js": "^1.422.5",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "sanity": "^5.23.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.6",
    "@storybook/addon-docs": "10.5.6",
    "@storybook/addon-vitest": "10.5.6",
    "@storybook/nextjs-vite": "10.5.6",
    "@tailwindcss/postcss": "^4.2.4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.5",
    "ajv": "8.17.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "playwright": "1.59.1",
    "storybook": "10.5.6",
    "tailwindcss": "^4.2.4",
    "typescript": "^5",
    "vite": "7.3.2",
    "vitest": "4.1.5"
  }
}
