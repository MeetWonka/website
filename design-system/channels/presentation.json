{
  "$schema": "../schemas/channel.schema.json",
  "schemaVersion": "1.0.0",
  "id": "channel.presentation",
  "name": "Presentation",
  "description": "Executive, sales, workshop, and product decks that share the same tokens and branded hierarchy.",
  "aliases": ["presentation"],
  "lifecycle": "review_required",
  "stability": "experimental",
  "introducedIn": "0.2.0",
  "allowedThemes": ["light", "dark"],
  "distribution": "external",
  "tokenSets": ["color", "semantic.color", "typography", "radius", "component"],
  "compatibleAssetIds": [
    "asset.logo.wordmark",
    "asset.logo.mark",
    "asset.font.inter-display",
    "asset.font.gt-sectra"
  ],
  "constraints": [
    {
      "id": "canvas",
      "value": "Use a 16:9 widescreen canvas unless the destination requires another format.",
      "level": "required",
      "enforcement": "contract"
    },
    {
      "id": "minimum-type",
      "value": "Use at least 18pt body text and 12pt source or footnote text.",
      "level": "required",
      "enforcement": "contract"
    },
    {
      "id": "one-idea",
      "value": "Each slide carries one decision, argument, or evidence unit.",
      "level": "recommended",
      "enforcement": "human_review"
    },
    {
      "id": "editable",
      "value": "Keep text, charts, logos, and legal content editable and deterministic.",
      "level": "required",
      "enforcement": "human_review"
    }
  ],
  "exportTargets": ["pptx", "pdf", "png"],
  "provenance": {
    "source": "Wonka deck and website shared-system goal",
    "owner": "Wonka Design System",
    "approvedBy": null,
    "approvedAt": null
  }
}
