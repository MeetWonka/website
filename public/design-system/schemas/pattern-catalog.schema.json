{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonka-ai.com/design-system/schemas/pattern-catalog.schema.json",
  "title": "Wonka Pattern Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "brandVersionId", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "brandVersionId": { "type": "string", "minLength": 1 },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "kind",
          "status",
          "introducedIn",
          "source",
          "storyId",
          "channelIds",
          "requiredTokenSets",
          "requiredComponentIds",
          "requiredAssetIds",
          "requiredRuleIds",
          "slots",
          "agent",
          "usage"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pattern\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
          },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["artifact", "documentation", "governance"]
          },
          "status": {
            "enum": ["draft", "beta", "stable", "deprecated", "retired"]
          },
          "introducedIn": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
          },
          "source": { "type": "string", "minLength": 1 },
          "storyId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*--[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "channelIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^channel\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          },
          "requiredTokenSets": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredComponentIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^component\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          },
          "requiredAssetIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^asset\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          },
          "requiredRuleIds": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^rule\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$"
            }
          },
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "role", "required", "instruction"],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "role": {
                  "enum": [
                    "constraint",
                    "content",
                    "control",
                    "evidence",
                    "interface",
                    "sequence",
                    "signature"
                  ]
                },
                "required": { "type": "boolean" },
                "instruction": { "type": "string", "minLength": 1 }
              }
            }
          },
          "agent": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "requiredInputs",
              "requiredTraceFields",
              "humanReviewTriggers"
            ],
            "properties": {
              "requiredInputs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "requiredTraceFields": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              },
              "humanReviewTriggers": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          "usage": {
            "type": "object",
            "additionalProperties": false,
            "required": ["do", "dont"],
            "properties": {
              "do": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "dont": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
