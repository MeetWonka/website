{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wonka-ai.com/design-system/schemas/rule-catalog.schema.json",
  "title": "Wonka Design System Rule Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "version", "rules"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": "1.0.0" },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "exclude": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "contrastPair": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "foreground", "background", "minimum"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "foreground": { "type": "string", "minLength": 1 },
        "background": { "type": "string", "minLength": 1 },
        "minimum": { "type": "number", "minimum": 1, "maximum": 21 }
      }
    },
    "validator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "raw_color",
            "forbidden_pattern",
            "contrast",
            "asset_rights",
            "generated_drift",
            "lifecycle_approval",
            "manual"
          ]
        },
        "pattern": { "type": "string", "minLength": 1 },
        "flags": {
          "type": "string",
          "pattern": "^[imsu]*$"
        },
        "pairs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/contrastPair" }
        },
        "checklist": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "owner", "approvedBy", "approvedAt"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "approvedBy": { "type": ["string", "null"] },
        "approvedAt": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description",
        "lifecycle",
        "stability",
        "introducedIn",
        "severity",
        "channelIds",
        "scope",
        "validator",
        "rationale",
        "exceptionsAllowed",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^rule\\.[a-z0-9-]+$"
        },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "lifecycle": {
          "enum": [
            "draft",
            "review_required",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "stability": {
          "enum": ["experimental", "beta", "stable"]
        },
        "introducedIn": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "severity": { "enum": ["warning", "error"] },
        "channelIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^channel\\.[a-z0-9-]+$"
          }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "validator": { "$ref": "#/$defs/validator" },
        "rationale": { "type": "string", "minLength": 1 },
        "exceptionsAllowed": { "type": "boolean" },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
